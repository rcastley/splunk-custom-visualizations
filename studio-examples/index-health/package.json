{
	"name": "index_health",
	"version": "0.1.0",
	"description": "Monitor indexing activity, storage, and health status across Splunk indexes",
	"author": "rcastley",
	"type": "module",
	"scripts": {
		"build": "node build.mjs --entry=visualization.ts",
		"build:prod": "NODE_ENV=production node build.mjs --entry=visualization.ts",
		"dev": "node build.mjs --entry=visualization.ts --watch",
		"package": "node package.mjs",
		"typecheck": "tsc --noEmit",
		"test:harness": "node harness-smoke.mjs"
	},
	"devDependencies": {
		"@splunk/dashboard-studio-extension": "^1.0.0",
		"chalk": "^5.3.0",
		"esbuild": "^0.27.3",
		"tar": "^7.4.3",
        "typescript": "^5.8.3"
	}
}
